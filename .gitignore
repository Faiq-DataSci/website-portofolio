#########################
# CodeIgniter 4
#########################

# Environment file
.env

# Writable directories - keep structure, ignore content
writable/cache/*
!writable/cache/index.html

writable/logs/*
!writable/logs/index.html

writable/session/*
!writable/session/index.html

writable/uploads/*
!writable/uploads/index.html

writable/debugbar/*

# Composer
vendor/

#########################
